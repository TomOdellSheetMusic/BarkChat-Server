# BarkChat Server – Environment Configuration
# Copy this file to .env and fill in the values.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ── Security ─────────────────────────────────────────────────────────────────
# 64-character hex string (32 bytes) used to encrypt channel messages at rest.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./barkchat.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Restrict to your client's origin in production, e.g.:
#   CORS_ORIGIN=https://chat.example.com
# Use '*' only in development.
CORS_ORIGIN=*

# ── Reverse Proxy ─────────────────────────────────────────────────────────────
# Set to true when running behind nginx / Caddy / Traefik so that Express
# trusts the X-Forwarded-For and X-Forwarded-Proto headers.
TRUST_PROXY=false

# ── TLS (optional – leave HTTPS_ENABLED=false if the proxy terminates TLS) ──
HTTPS_ENABLED=false
HTTPS_KEY_PATH=./certs/server.key
HTTPS_CERT_PATH=./certs/server.crt
